# CyberFortress environment example — copy to .env and fill secrets
# Never commit .env

CF_CONTAINMENT_LIVE=false
CF_ALLOW_FORCE=false
CF_WATCHDOG_FAIL_CLOSED=true
CF_AUTO_RESPOND=true

# Rule pack: default | retail | finance | smb
CF_RULE_PACK_NAME=default

# Multi-tenant (optional)
# CF_TENANT_ID=example_client

# Weekly evidence pack (seconds; default 7 days)
CF_WEEKLY_EVIDENCE_SECONDS=604800
CF_WEEKLY_EVIDENCE_ON_START=false

# Daily WhatsApp report
# CF_WHATSAPP_REPORT_TO=+18683620679
# CF_REPORT_INTERVAL_SECONDS=86400
# CF_REPORT_ON_START=true

# Meta WhatsApp Cloud API (secrets)
# CF_WHATSAPP_TOKEN=
# CF_WHATSAPP_PHONE_NUMBER_ID=
# CF_WHATSAPP_VERIFY_TOKEN=cf_verify_token_change_me
# CF_WHATSAPP_MOCK=true
