# CyberFortress environment template
# Copy to .env and fill in real values. NEVER commit .env
#
#   cp .env.example .env
#   chmod 600 .env

# ---------------------------------------------------------------------------
# SAFETY — keep these until pilot sign-off (see docs/PILOT_DEPLOYMENT.md)
# ---------------------------------------------------------------------------
CF_CONTAINMENT_LIVE=false
CF_ALLOW_FORCE=false
CF_WATCHDOG_FAIL_CLOSED=true

# ---------------------------------------------------------------------------
# Dashboard auth (recommended)
# ---------------------------------------------------------------------------
CF_DASHBOARD_USER=operator
CF_DASHBOARD_PASS=
CF_DASHBOARD_BIND=127.0.0.1
CF_DASHBOARD_PORT=8091

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API) — required for live HITL
# ---------------------------------------------------------------------------
CF_WHATSAPP_ENABLED=false
CF_WHATSAPP_TOKEN=
CF_WHATSAPP_PHONE_NUMBER_ID=
CF_WHATSAPP_ADMINS=
CF_WHATSAPP_VERIFY_TOKEN=change_me_to_a_long_random_string
CF_APPROVAL_TIMEOUT=300

# ---------------------------------------------------------------------------
# Identity provider: local_linux | ldap | azure_ad
# ---------------------------------------------------------------------------
CF_IDENTITY_PROVIDER=local_linux

# ---------------------------------------------------------------------------
# Live telemetry (optional)
# ---------------------------------------------------------------------------
# CF_SENTINEL_API_URL=
# CF_SENTINEL_API_KEY=
# CF_MIRAGE_API_URL=
# CF_MIRAGE_API_KEY=

# ---------------------------------------------------------------------------
# Watchdog / backup
# ---------------------------------------------------------------------------
CF_WATCHDOG_INTERVAL=60
# CF_BACKUP_DEST=/mnt/offbox/cyberfortress-backups
