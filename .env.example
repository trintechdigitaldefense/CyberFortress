# CyberFortress environment template — copy to .env (never commit .env)
# CF_CONTAINMENT_LIVE=false
# CF_ALLOW_FORCE=false
# CF_CLIENT_NAME=Demo Client
# CF_DASHBOARD_PASS=
# CF_DASHBOARD_REQUIRE_AUTH=false
# CF_ALLOW_PUBLIC_BIND=false
# CF_WHATSAPP_ENABLED=false
# CF_WHATSAPP_TOKEN=
# CF_WHATSAPP_PHONE_NUMBER_ID=
# CF_WHATSAPP_ADMINS=
# CF_WHATSAPP_REPORT_TO=
# CF_WHATSAPP_APP_SECRET=
# CF_WHATSAPP_REQUIRE_SIGNATURE=false
# CF_MAX_BODY_BYTES=262144
# CF_RATE_LIMIT_MAX=120
# CF_RATE_LIMIT_WINDOW=60

# --- Fusion (threat agent is primary collector) ---
# CF_FUSION_PROCESS=false
# CF_FUSION_INTERVAL=30

# --- IR team ---
# CF_IR_MIN_SCORE=55
# CF_IR_RESPOND_MIN_SCORE=60
# CF_IR_AUTO_RESPOND=true
# CF_IR_NOTIFY_REPORTS=true
